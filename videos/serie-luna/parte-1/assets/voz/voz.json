  },
  {
   "inicio": 7.43,
   "fin": 8.39,
   "texto": "Y no habla de ella."
  },
  {
   "inicio": 9.33,
   "fin": 10.03,
   "texto": "Habla de él."
  },
  {
   "inicio": 10.53,
   "fin": 13.77,
   "texto": "Todo empezó con un anuncio, vive gratis un mes en un ático del centro."
  },
  {
   "inicio": 14.21,
   "fin": 17.11,
   "texto": "Buscaban personas para probar una asistente que lo controla todo."
  },
  {
   "inicio": 17.57,
   "fin": 18.15,
   "texto": "Se llama Luna."
  },
  {
   "inicio": 18.59,
   "fin": 22.97,
   "texto": "El trato, 30 días en la casa, y cada noche, 10 minutos de charla con ella."
  },
  {
   "inicio": 24.57,
   "fin": 27.65,
   "texto": "Te dio las llaves marcos, el dueño, con una sola norma."
  },
  {
   "inicio": 27.65,
   "fin": 29.85,
   "texto": "Pase lo que pase, nunca la desconectes."
  },
  {
   "inicio": 30.21,
   "fin": 33.99,
   "texto": "Y Luna es perfecta, el café, como te gusta, antes de que lo pidas."
  },
  {
   "inicio": 34.47,
   "fin": 36.09,
   "texto": "Y unas palabras cuando te duermes."
  },
  {
   "inicio": 37.03,
   "fin": 38.91,
   "texto": "Las mismas que te decía tu padre cada noche."
  },
  {
   "inicio": 39.47,
   "fin": 40.67,
   "texto": "Descansa, campeón."
  },
  {
   "inicio": 41.23,
   "fin": 42.57,
   "texto": "Tu padre murió hace 6 años."
  },
  {
   "inicio": 43.61,
   "fin": 45.19,
   "texto": "Y tu nunca le contaste nada a Luna."
  },
  {
   "inicio": 45.77,
