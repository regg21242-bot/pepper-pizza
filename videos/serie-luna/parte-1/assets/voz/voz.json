  },
  {
   "inicio": 54.05,
   "fin": 55.67,
   "texto": "Se va la luz en todo el edificio."
  },
  {
   "inicio": 56.43,
   "fin": 58.83,
   "texto": "Menos en tu casa, el ático sigue encendido."
  },
  {
   "inicio": 59.57,
